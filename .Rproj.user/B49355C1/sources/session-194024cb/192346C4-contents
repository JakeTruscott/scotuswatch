counsel_missing_docket_search <- function (docket_id){
  
  process_docket_id <- function(docket_id) {
    docket_url_newer <- "https://www.supremecourt.gov/search.aspx?filename=/docket/docketfiles/html/public/"
    docket_url_older <- "https://www.supremecourt.gov/search.aspx?filename=/docketfiles/"
    term <- as.data.frame(docket_id)
    term <- term %>% mutate(type = 3) %>% mutate(type = ifelse(grepl("m", 
                                                                     docket_id, ignore.case = T), 2, type)) %>% mutate(type = ifelse(grepl("a", 
                                                                                                                                           docket_id, ignore.case = T), 1, type)) %>% mutate(type = ifelse(grepl("o", 
                                                                                                                                                                                                                 docket_id, ignore.case = T), 4, type)) %>% mutate(year = as.numeric(gsub("\\-.*|a.*|A.*|m.*|M.*|Original.*|original.*|o.*|O.*|Orig.*|orig.*", 
                                                                                                                                                                                                                                                                                          "", docket_id))) %>% mutate(year = ifelse(as.numeric(year) %in% 
                                                                                                                                                                                                                                                                                                                                      0:9, as.character(paste0(sprintf("%02d", year))), 
                                                                                                                                                                                                                                                                                                                                    as.character(year))) %>% mutate(docket_number = gsub(".*\\-|.*a|.*A|.*m|.*M|.*Original|.*original|.*o|.*O|.*Orig|.*orig", 
                                                                                                                                                                                                                                                                                                                                                                                         "", docket_id)) %>% mutate(year = gsub("[^0-9]", 
                                                                                                                                                                                                                                                                                                                                                                                                                                "", year), docket_number = gsub("[^0-9]", "", docket_number)) %>% 
      mutate(html = ifelse(as.numeric(year) > 50, "HTM", 
                           ifelse(as.numeric(year) < 17, "HTM", ifelse(as.numeric(year) >= 
                                                                         17 & as.numeric(year) < 30, "HTML", "HTM")))) %>% 
      mutate(url = case_when(type == 1 & html == "HTM" ~ 
                               paste0(docket_url_older, year, "a", docket_number, 
                                      ".htm"), type == 1 & html == "HTML" ~ paste0(docket_url_newer, 
                                                                                   year, "a", docket_number, ".html"), type == 2 & 
                               html == "HTM" ~ paste0(docket_url_older, year, 
                                                      "m", docket_number, ".htm"), type == 2 & html == 
                               "HTML" ~ paste0(docket_url_newer, year, "m", 
                                               docket_number, ".html"), type == 3 & html == 
                               "HTM" ~ paste0(docket_url_older, year, "-", docket_number, 
                                              ".htm"), type == 3 & html == "HTML" ~ paste0(docket_url_newer, 
                                                                                           year, "-", docket_number, ".html"), type == 4 & 
                               html == "HTM" ~ paste0(docket_url_older, year, 
                                                      "o", docket_number, ".htm"), type == 4 & html == 
                               "HTML" ~ paste0(docket_url_newer, year, "o", 
                                               docket_number, ".html")))
    urls <- term$url
    return(urls)
  }
  docket_info <- function(response, docket) {
    html_content <- httr::content(response, as = "text")
    parsed_html <- rvest::read_html(html_content)
    info_meta <- parsed_html %>% rvest::html_element("#docketinfo") %>% 
      rvest::html_table(fill = T) %>% dplyr::select(X1, 
                                                    X2) %>% dplyr::rename(information = X1, entry = X2) %>% 
      dplyr::mutate(information = ifelse(grepl("Linked with", 
                                               information, ignore.case = T), gsub("Linked with", 
                                                                                   "Linked with:", information, ignore.case = T), 
                                         information), entry = ifelse(grepl("Linked with\\:", 
                                                                            information, ignore.case = T), gsub(".*with\\:", 
                                                                                                                "", trimws(information)), entry), information = ifelse(grepl("Linked with\\:", 
                                                                                                                                                                             information), gsub("with\\:.*", "with:", information), 
                                                                                                                                                                       information), entry = trimws(entry)) %>% dplyr::filter(grepl("\\:", 
                                                                                                                                                                                                                                    information)) %>% dplyr::mutate(information = gsub("\\:", 
                                                                                                                                                                                                                                                                                       "", information), entry = ifelse(entry == "", NA, 
                                                                                                                                                                                                                                                                                                                        entry)) %>% tidyr::pivot_wider(names_from = information, 
                                                                                                                                                                                                                                                                                                                                                       values_from = entry) %>% dplyr::rename_with(~gsub(" ", 
                                                                                                                                                                                                                                                                                                                                                                                                         "_", tolower(.x))) %>% dplyr::mutate(petitioner = trimws(gsub(" v\\..*", 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                       "", title)), petitioner = trimws(gsub(" Petitioner.*", 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             "", petitioner)), petitioner = trimws(gsub("\\, et al\\.\\,$", 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ", et al.", petitioner)), respondent = trimws(gsub(".* v\\.", 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           "", title)), docket = docket) %>% dplyr::relocate(petitioner, 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             respondent, .after = title) %>% dplyr::relocate(docket, 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             .after = title)
    if (!"linked_with" %in% names(info_meta)) {
      info_meta <- info_meta %>% dplyr::mutate(linked_with = NA) %>% 
        dplyr::relocate(linked_with, .after = docketed)
    }
    else {
      info_meta <- info_meta %>% dplyr::mutate(linked_with = ifelse(linked_with %in% 
                                                                      c("\\:", ":", "\\: ", " \\:"), NA, linked_with))
    }
    return(info_meta)
  }
  docket_entries <- function(response) {
    proceedings <- httr::content(response, as = "text") %>% 
      read_html() %>% html_element("#proceedings")
    rows <- proceedings %>% html_elements("table.ProceedingItem tr")
    temp_docket_entries <- purrr::map_dfr(rows, function(row) {
      date <- row %>% html_element(".ProceedingDate") %>% 
        html_text(trim = TRUE)
      text_cell <- row %>% html_elements("td") %>% .[[2]]
      description <- text_cell %>% html_text(trim = TRUE)
      main_doc <- text_cell %>% html_elements(".documentlinks a") %>% 
        purrr::keep(~html_text(.x, trim = TRUE) %in% 
                      c("Main Document", "Petition"))
      tibble(date = lubridate::mdy(date), description = description, 
             url = if (length(main_doc) > 0) {
               html_attr(main_doc, "href")
             }
             else {
               NA_character_
             })
    })
    return(temp_docket_entries)
  }
  counsel <- function(response) {
    html_content <- httr::content(response, as = "text")
    doc <- html_content %>% gsub("(<br>|<br/>|<br />)", "\n", 
                                 .) %>% read_html()
    cards <- doc %>% html_element("#Contacts") %>% html_elements(".card")
    counsel_temp <- purrr::map_df(cards, function(card) {
      section <- card %>% html_element(".card-heading") %>% 
        html_text(trim = TRUE)
      names <- card %>% html_elements(".ContactName") %>% 
        html_text(trim = TRUE)
      data <- card %>% html_elements(".ContactData2") %>% 
        html_text(trim = TRUE)
      data <- data %>% str_replace_all("\\r|\\n", "\n") %>% 
        str_split("\n") %>% lapply(function(x) trimws(x[x != 
                                                          ""])) %>% lapply(function(x) x[nzchar(trimws(x))])
      tibble(section = section, contact_name = names, contact_data = data) %>% 
        mutate(counsel_of_record = ifelse(grepl("Counsel of Record", 
                                                contact_name, ignore.case = T), "Counsel of Record", 
                                          "Other"), contact_name = stringr::str_squish(gsub("Counsel of.*", 
                                                                                            "", contact_name, ignore.case = T)))
    })
    return(counsel_temp)
  }
  principal_counsel <- function(temp_counsel) {
    principal_counsel <- temp_counsel %>% dplyr::filter(counsel_of_record == 
                                                          "Counsel of Record") %>% filter(!section == "Other Attorneys")
    return(principal_counsel)
  }
  check_package_install <- function() {
    check_and_load_packages <- function(packages) {
      for (pkg in packages) {
        if (!requireNamespace(pkg, quietly = TRUE)) {
          cat(sprintf("Package '%s' is not installed. Do you want to install it? (Y/N): ", 
                      pkg))
          response <- tolower(readline())
          if (response == "y") {
            install.packages(pkg)
          }
          else if (response == "n") {
            stop(sprintf("Cannot proceed without '%s' installed. Exiting.", 
                         pkg))
          }
          else {
            stop("Invalid input. Please enter Y or N. Exiting.")
          }
        }
        library(pkg, character.only = TRUE)
      }
    }
    required_packages <- c("dplyr", "rvest", "reticulate", 
                           "httr", "tm", "stringr", "tm", "tidyr", "graphics", 
                           "utils", "htm2txt", "zoo", "pdftools")
    check_and_load_packages(required_packages)
    library(dplyr)
    library(rvest)
    library(reticulate)
    library(httr)
    library(tm)
    library(stringr)
    library(tm)
    library(tidyr)
    library(graphics)
    library(utils)
    library(htm2txt)
    library(zoo)
    library(pdftools)
  }
  suppressMessages(suppressWarnings(suppressPackageStartupMessages(check_package_install())))
  temp_docket_url <- process_docket_id(docket_id)
  response <- httr::GET(temp_docket_url)
  temp_docket_info <- docket_info(response, docket_id)
  temp_docket_entries <- docket_entries(response)
  temp_counsel <- counsel(response)
  if (nrow(temp_counsel) >= 1){
    temp_principal_counsel <- principal_counsel(temp_counsel)
    combined_temp <- temp_docket_info %>% dplyr::mutate(docket_entries = list(temp_docket_entries), 
                                                        counsel = list(temp_counsel))
  } else {
    combined_temp <- temp_docket_info %>% dplyr::mutate(docket_entries = list(temp_docket_entries), 
                                                        counsel = list(temp_counsel))
  }
  
  
  return(combined_temp)
}