o <- scdb_justices %>%
  filter(term >= 1980) %>%
  filter(opinion %in% c(2, 3)) %>%
  group_by(docket) %>%
  summarise(opinion = n()) %>%
  left_join(scdb_justices %>% 
              select(term, docket), by = 'docket') %>%
  group_by(term) %>%
  summarise(mean_opinions = mean(opinion, na.rm = T), .groups = 'drop') %>%
  mutate(term = as.numeric(term), 
         mean_opinions = as.numeric(round(mean_opinions, 0))) 
