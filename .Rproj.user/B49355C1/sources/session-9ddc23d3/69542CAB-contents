d <- 'Stat Reviews/OT24_StatReview/dockets/processed_dockets'

d <- list.files('Stat Reviews/OT24_StatReview/dockets/processed_dockets', full.names = T)

dockets <- data.frame()

for (i in 1:length(d)){
  
  temp_d <- get(load(d[i]))
  dockets <- bind_rows(dockets, temp_d)

  if (i %% 25 == 0){
    message(i)
  }
    
}



dockets_combined <- data.frame()

for (i in 1:nrow(dockets)){
  
  temp_docket <- dockets[i,]
  temp_docket_number <- temp_docket$docket
  temp_docket_entries <- data.frame(temp_docket$docket_entries) %>%
    filter(grepl('(Amicus|Amici)', entry, ignore.case = T)) %>%
    filter(grepl('filed', entry, ignore.case = T))
  
  temp_entry <- data.frame(docket = temp_docket_number, amici = nrow(temp_docket_entries))
  
  dockets_combined <- bind_rows(dockets_combined, temp_entry)

  if (i %% 50 == 0){
    message(i)
  }
    
}


dockets_combined %>%
  group_by(amici) %>%
  summarise(count = n())


