d <- get(load("D:/scotus_docket_sheets_2001_2023/SCOTUS_Dockets_OT01-OT24.rdata"))

d <- dockets_ot01_ot24 %>%
  mutate(term_year = as.numeric(gsub('(A|M|\\-).*', '', docket_number))) %>%
  filter(term_year %in% c(15:23))

dockets <- d %>%
  filter(grepl('\\-', docket_number))

dockets_15_23 <- data.frame()


for (i in 1:nrow(dockets)){
  
  temp_row <- dockets[i,]
  temp_docket_sheet <- temp_row$docket[[1]] %>%
    mutate(action = case_when(
      grepl('petition', entry, ignore.case = T) & grepl('GRANTED', entry, ignore.case = F) ~ 'Grant', 
      grepl('petition', entry, ignore.case = T) & grepl('(DENIED|Dismissed|Dismiss)', entry, ignore.case = T) ~ 'Denied', 
      grepl('(Dismissed as |Dismiss as)', entry, ignore.case = T) ~ 'DIG', 
      grepl('Summary', entry, ignore.case = T) ~ 'Summary Judgment', 
      grepl('Affirmed', entry, ignore.case = T) ~ 'Affirmed', 
      grepl('(Reverse|Reversed)', entry, ignore.case = T) ~ 'Reversed', 
      grepl('(Vacate|Vacated)', entry, ignore.case = T) ~ 'Vacated'
    )) %>%
    filter(!is.na(action))
  
  if (nrow(temp_docket_sheet) >= 1){
    action <- temp_docket_sheet %>%
      slice_tail(n = 1) %>%
      pull(action)
    action_entry  <- temp_docket_sheet %>%
      slice_tail(n = 1) %>%
      pull(entry)
  } else {
    action <- 'Unknown'
    action_entry <- temp_docket_sheet <- temp_row$docket[[1]] %>%
      slice_tail(n = 1) %>%
      pull(entry)
  }
  
  temp_row <- temp_row %>%
    select(-c(docket, counsel, term_year)) %>%
    mutate(action = action, 
           action_entry = action_entry)
  
  dockets_15_23 <- bind_rows(dockets_15_23, temp_row)
  
  if (i %% 100 == 0){
    message('Completed Row ', i, ' of ', nrow(dockets))
  }
  
}

write.csv(dockets_15_23, file = "C:/Users/jaketruscott/Desktop/dockets_15_23.csv", row.names = F)

