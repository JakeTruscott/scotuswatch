															<li class=3D"tab-item-selected">
							<a href=3D"https://supreme.justia.com/cases/federal/us/607/24-1159/#=
tab-opinion-5139454" class=3D"highlight nav-item" data-go-to=3D"tab-opinion=
" data-equivalent=3D"link-opinion-5139454" id=3D"list-opinion-5139454" data=
-gtm-type=3D"click" data-gtm-label=3D"Opinions Tab - Per Curiam" data-gtm-c=
ategory=3D"Supreme Court" data-gtm-action=3D"Content" data-extra-gap=3D".ti=
