scotusblog_stats$opinions

majorities <- data.frame(scotusblog_stats$opinions$opinions_by_justice) %>%
  filter(Opinion_Type == 'Majority') %>%
  group_by(Justice) %>%
  mutate(row_id = row_number()) %>%
  ungroup() %>%
  select(Justice, row_id, Case) %>%
  pivot_wider(names_from = Justice,
              values_from = Case) %>%
  select(-c(row_id)) %>%
  mutate(type = 'Majority')

dissents <- data.frame(scotusblog_stats$opinions$opinions_by_justice) %>%
  filter(Opinion_Type == 'Dissent') %>%
  group_by(Justice) %>%
  mutate(row_id = row_number()) %>%
  ungroup() %>%
  select(Justice, row_id, Case) %>%
  pivot_wider(names_from = Justice,
              values_from = Case) %>%
  select(-c(row_id)) %>%
  mutate(type = 'Dissent')

concurrences <- data.frame(scotusblog_stats$opinions$opinions_by_justice) %>%
  filter(!Opinion_Type %in% c('Majority', 'Dissent')) %>%
  group_by(Justice) %>%
  mutate(row_id = row_number()) %>%
  ungroup() %>%
  select(Justice, row_id, Case) %>%
  pivot_wider(names_from = Justice,
              values_from = Case) %>%
  select(-c(row_id)) %>%
  mutate(type = 'Concurrence')

majorities %>%
  bind_rows(concurrences) %>%
  bind_rows(dissents) %>%
  mutate(across(everything(), ~ replace_na(.x, ""))) %>%
  relocate(type) %>%
  rename('Opinion Type' = type) %>%
  kbl(
    format = "latex",
    booktabs = TRUE,
    longtable = TRUE,
    escape = TRUE
  ) %>%
  collapse_rows(columns = 1, valign = "middle") %>%
  kable_styling(
    font_size = 9,
    latex_options = c("striped", "repeat_header")
  ) %>%
  column_spec(1:9, width = "2.75cm")

